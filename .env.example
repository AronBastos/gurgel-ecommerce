# Copie para .env e ajuste conforme necessário: cp .env.example .env
# O .env é lido automaticamente pelo docker compose.

# --- PostgreSQL ---
POSTGRES_DB=gurgel_db
POSTGRES_USER=gurgel
POSTGRES_PASSWORD=gurgel

# --- Backend (Spring Boot) ---
# Em docker compose o host do banco é o nome do serviço (postgres), não localhost.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/gurgel_db
SPRING_DATASOURCE_USERNAME=gurgel
SPRING_DATASOURCE_PASSWORD=gurgel
